generator client {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ─── Enums ──────────────────────────────────────────────

enum Role {
  MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum Department {
  ENGINEERING
  HR
  FINANCE
  MARKETING
  SALES
  OPERATIONS
}

enum LeaveType {
  SICK
  VACATION
  PERSONAL
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  DENIED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

// ─── Models ─────────────────────────────────────────────

model Employee {
  id          String         @id @default(uuid())
  employeeId  String         @unique @map("employee_id")
  firstName   String         @map("first_name")
  lastName    String         @map("last_name")
  email       String         @unique
  phoneNumber String?        @map("phone_number")
  department  Department
  position    String
  role        Role           @default(EMPLOYEE)
  hireDate    DateTime       @map("hire_date")
  status      EmployeeStatus @default(ACTIVE)
  address     String?
  avatarUrl   String?        @map("avatar_url")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Relations
  leaveRequests  LeaveRequest[]             @relation("EmployeeLeaves")
  reviewedLeaves LeaveRequest[]             @relation("ReviewerLeaves")
  assignedTasks  TaskAssignment[]           @relation("AssignedTasks")
  createdTasks   TaskAssignment[]           @relation("CreatedTasks")
  postedJobs     JobPosting[]               @relation("PostedJobs")
  statusChanges  ApplicationStatusHistory[] @relation("StatusChanges")
  salesPipelines SalesPipeline[]            @relation("SalesPipelines")
  salesReports   SalesReport[]              @relation("SalesReports")

  @@map("employees")
}

model LeaveRequest {
  id           String      @id @default(uuid())
  employeeId   String      @map("employee_id")
  type         LeaveType
  startDate    DateTime    @map("start_date")
  endDate      DateTime    @map("end_date")
  reason       String
  status       LeaveStatus @default(PENDING)
  reviewedById String?     @map("reviewed_by_id")
  reviewedAt   DateTime?   @map("reviewed_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  // Relations
  employee   Employee  @relation("EmployeeLeaves", fields: [employeeId], references: [id])
  reviewedBy Employee? @relation("ReviewerLeaves", fields: [reviewedById], references: [id])

  @@map("leave_requests")
}

model TaskAssignment {
  id           String       @id @default(uuid())
  title        String
  description  String?
  assignedToId String       @map("assigned_to_id")
  assignedById String       @map("assigned_by_id")
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(TODO)
  deadline     DateTime
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Relations
  assignedTo Employee @relation("AssignedTasks", fields: [assignedToId], references: [id])
  assignedBy Employee @relation("CreatedTasks", fields: [assignedById], references: [id])

  @@map("task_assignments")
}

// ========== Recruitment module ==========

enum JobPostingStatus {
  ACTIVE
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  INTERVIEW
  OFFER
  REJECTED
  HIRED
}

model JobPosting {
  id           String           @id @default(uuid())
  title        String
  description  String
  requirements String
  location     String
  department   Department
  status       JobPostingStatus @default(ACTIVE)
  datePosted   DateTime         @default(now()) @map("date_posted")
  dateClosed   DateTime?        @map("date_closed")

  postedById String   @map("posted_by_id")
  postedBy   Employee @relation("PostedJobs", fields: [postedById], references: [id])

  applications Application[]

  @@map("job_postings")
}

model Applicant {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String?
  resumeUrl   String   @map("resume_url")
  coverLetter String?  @map("cover_letter")
  accessToken String   @unique @default(uuid()) @map("access_token")
  createdAt   DateTime @default(now()) @map("created_at")

  applications Application[]

  @@map("applicants")
}

model Application {
  id           String            @id @default(uuid())
  applicantId  String            @map("applicant_id")
  jobPostingId String            @map("job_posting_id")
  status       ApplicationStatus @default(APPLIED)
  dateApplied  DateTime          @default(now()) @map("date_applied")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  applicant     Applicant                  @relation(fields: [applicantId], references: [id])
  jobPosting    JobPosting                 @relation(fields: [jobPostingId], references: [id])
  statusHistory ApplicationStatusHistory[]

  @@unique([applicantId, jobPostingId])
  @@map("applications")
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid())
  applicationId String             @map("application_id")
  oldStatus     ApplicationStatus?
  newStatus     ApplicationStatus
  changedById   String?            @map("changed_by_id")
  timestamp     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id])
  changedBy   Employee?   @relation("StatusChanges", fields: [changedById], references: [id])

  @@map("application_status_history")
}

// ========== Product & Item Catalog module ==========

model Category {
  id          String  @id @default(uuid())
  name        String
  description String?

  parentId      String?    @map("parent_id")
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  subcategories Category[] @relation("CategoryHierarchy")

  products Product[]

  @@map("categories")
}

model Product {
  id          String @id @default(uuid())
  name        String
  description String
  status      String @default("ACTIVE") // e.g. ACTIVE, DISCONTINUED, DRAFT
  brand       String

  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  variants ProductVariant[]
  bundles  BundleProduct[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model ProductVariant {
  id          String @id @default(uuid())
  variantName String @map("variant_name")

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  attributes VariantAttribute[]
  skus       SKU[]
  prices     Price[]

  @@map("product_variants")
}

model VariantAttribute {
  id             String @id @default(uuid())
  attributeName  String @map("attribute_name")
  attributeValue String @map("attribute_value")

  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("variant_attributes")
}

model SKU {
  id       String @id @default(uuid())
  skuCode  String @unique @map("sku_code")
  quantity Int    @default(0)
  status   String @default("IN_STOCK") // IN_STOCK, OUT_OF_STOCK, DISCONTINUED

  variantId  String         @map("variant_id")
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("skus")
}

model Price {
  id            String    @id @default(uuid())
  amount        Decimal
  currency      String    @default("USD")
  priceType     String    @map("price_type") // RETAIL, WHOLESALE, REGIONAL
  region        String? // used when priceType is REGIONAL
  effectiveDate DateTime  @map("effective_date")
  expiryDate    DateTime? @map("expiry_date")

  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("prices")
}

model ProductBundle {
  id             String  @id @default(uuid())
  name           String
  description    String?
  status         String  @default("ACTIVE")
  bundleDiscount Decimal @map("bundle_discount")

  products BundleProduct[]

  @@map("product_bundles")
}

model BundleProduct {
  id        String        @id @default(uuid())
  bundleId  String        @map("bundle_id")
  bundle    ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String        @map("product_id")
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleId, productId])
  @@map("bundle_products")
}

// ========== End Product & Item Catalog module ========== 

// ========== CRM module ==========

enum LeadSource {
  WEBSITE
  REFERRAL
  COLD_CALL
  SOCIAL_MEDIA
  EVENT
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
  CONVERTED
}

enum PipelineStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum InteractionType {
  CALL
  EMAIL
  MEETING
  NOTE
}

model Customer {
  id         String  @id @default(uuid())
  customerId String  @unique @map("customer_id")
  name       String
  email      String  @unique
  phone      String?
  address    String?

  interactions      InteractionHistory[]
  pipelines         SalesPipeline[]
  convertedFromLead Lead?
  subscriptions     Subscription[]
  orders            Order[]
  returnRequests    ReturnRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("customers")
}

model Lead {
  id                String     @id @default(uuid())
  leadId            String     @unique @map("lead_id")
  name              String
  email             String
  source            LeadSource
  qualificationStat LeadStatus @default(NEW) @map("qualification_stat")
  score             Int        @default(0)

  convertedCustomerId String?   @unique @map("converted_customer_id")
  convertedCustomer   Customer? @relation(fields: [convertedCustomerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("leads")
}

model SalesPipeline {
  id                String        @id @default(uuid())
  pipelineId        String        @unique @map("pipeline_id")
  stage             PipelineStage @default(PROSPECTING)
  dealValue         Decimal       @map("deal_value")
  expectedCloseDate DateTime      @map("expected_close_date")

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])

  employeeId String   @map("employee_id")
  employee   Employee @relation("SalesPipelines", fields: [employeeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sales_pipelines")
}

model InteractionHistory {
  id            String          @id @default(uuid())
  interactionId String          @unique @map("interaction_id")
  date          DateTime
  type          InteractionType
  notes         String?

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("interaction_histories")
}

model SalesReport {
  id          String  @id @default(uuid())
  reportId    String  @unique @map("report_id")
  period      String // e.g. "2026-Q3", "2026-08"
  region      String
  revenue     Decimal @default(0)
  dealsClosed Int     @default(0) @map("deals_closed")
  dealsLost   Int     @default(0) @map("deals_lost")

  employeeId String   @map("employee_id")
  employee   Employee @relation("SalesReports", fields: [employeeId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("sales_reports")
}

// ========== End CRM module ==========

// ========== Subscription & Membership Management module ==========

model MembershipPlan {
  id                  String  @id @default(uuid())
  name                String
  tier                String
  price               Decimal
  billingIntervalDays Int     @default(30) @map("billing_interval_days")

  subscriptions Subscription[]

  @@map("membership_plans")
}

model Subscription {
  id        String   @id @default(uuid())
  startDate DateTime @map("start_date")
  status    String   @default("ACTIVE") // ACTIVE, CANCELLED, PAST_DUE, EXPIRED
  autoRenew Boolean  @default(true) @map("auto_renew")

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])

  planId String         @map("plan_id")
  plan   MembershipPlan @relation(fields: [planId], references: [id])

  billingCycles  BillingCycle[]
  renewalNotices RenewalNotice[]
  planChanges    SubscriptionPlanChange[]

  @@map("subscriptions")
}

model BillingCycle {
  id          String   @id @default(uuid())
  billingDate DateTime @map("billing_date")
  amount      Decimal
  status      String   @default("PENDING") // PENDING, PAID, FAILED

  subscriptionId String       @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("billing_cycles")
}

model RenewalNotice {
  id          String   @id @default(uuid())
  noticeType  String   @map("notice_type") // UPCOMING_RENEWAL, PAYMENT_FAILURE
  sentDate    DateTime @map("sent_date")
  renewalDate DateTime @map("renewal_date")

  subscriptionId String       @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("renewal_notices")
}

model SubscriptionPlanChange {
  id             String   @id @default(uuid())
  changeDate     DateTime @default(now()) @map("change_date")
  fromPlanId     String?  @map("from_plan_id")
  toPlanId       String   @map("to_plan_id")
  proratedAmount Decimal  @map("prorated_amount")

  subscriptionId String       @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_plan_changes")
}

// ========== End Subscription & Membership Management module ==========

// ========== Returns & Refunds Management module ==========

model Order {
  id          String   @id @default(uuid())
  orderDate   DateTime @default(now()) @map("order_date")
  totalAmount Decimal  @map("total_amount")

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])

  items          OrderItem[]
  returnRequests ReturnRequest[]

  @@map("orders")
}

model OrderItem {
  id       String  @id @default(uuid())
  quantity Int
  price    Decimal

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  skuId String @map("sku_id")
  sku   SKU    @relation(fields: [skuId], references: [id])

  returnRequests ReturnRequest[]

  @@map("order_items")
}

model ReturnRequest {
  id      String   @id @default(uuid())
  reason  String
  status  String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reqDate DateTime @default(now()) @map("req_date")

  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id])

  orderItemId String    @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  refundTransaction RefundTransaction?
  creditNote        CreditNote?

  @@map("return_requests")
}

model RefundTransaction {
  id         String   @id @default(uuid())
  amount     Decimal
  refundDate DateTime @default(now()) @map("refund_date")
  method     String   @default("ORIGINAL_PAYMENT")

  returnRequestId String        @unique @map("return_request_id")
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@map("refund_transactions")
}

model CreditNote {
  id        String   @id @default(uuid())
  amount    Decimal
  issueDate DateTime @default(now()) @map("issue_date")

  returnRequestId String        @unique @map("return_request_id")
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@map("credit_notes")
}

// ========== End Returns & Refunds Management module ==========
